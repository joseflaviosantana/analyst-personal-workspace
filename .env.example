# ==============================================================================
# Analyst Personal Workspace — Variáveis de Ambiente de Exemplo (.env.example)
# AVISO: Este arquivo é público e versionado. NUNCA insira credenciais, tokens,
# senhas ou dados corporativos reais aqui.
# ==============================================================================

# Ambiente de Execução
NODE_ENV=development
PORT=3000

# Persistência Local (SQLite)
# Caminho padrão conforme ADR-002 (isolado em .workspace/data/ protegido pelo .gitignore)
WORKSPACE_DB_PATH=.workspace/data/workspace.db
